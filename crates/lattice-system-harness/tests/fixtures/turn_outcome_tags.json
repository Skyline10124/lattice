    { "outcome": { "interrupted": { "reason": { "model_attempt": { "output_limit_exceeded": { "kind": "bogus", "limit": 2097152, "actual": 2097153 } } } } }, "why": "未知输出限额类型" },
    { "outcome": { "interrupted": { "reason": { "model_attempt": { "output_limit_exceeded": { "kind": "assistant_content", "limit": -1, "actual": 2097153 } } } } }, "why": "输出限额不能为负数" },
    { "outcome": { "interrupted": { "reason": { "model_attempt": { "output_limit_exceeded": { "kind": "assistant_content", "limit": 2097152 } } } } }, "why": "输出限额缺少 actual" },
    { "outcome": { "interrupted": { "reason": { "model_attempt": { "output_limit_exceeded": { "kind": "assistant_content", "limit": 2097152, "actual": 2097153 }, "timeout": null } } } }, "why": "模型尝试中断有两个标签" },
    { "outcome": { "interrupted": { "reason": { "invocation_may_have_occurred": {} } } }, "why": "缺少 invocation 身份" },
    { "outcome": { "interrupted": { "reason": { "invocation_may_have_occurred": { "invocation": "bogus" } } } }, "why": "invocation 不是 UUID" },
    { "outcome": { "interrupted": { "reason": { "invocation_may_have_occurred": { "invocation": "3F8B2C1A-7D4E-4F5A-8B9C-0D1E2F3A4B5C" } } } }, "why": "invocation 不接受大写 UUID" },
    { "outcome": { "interrupted": { "reason": { "invocation_may_have_occurred": { "invocation": "3f8b2c1a7d4e4f5a8b9c0d1e2f3a4b5c" } } } }, "why": "invocation 必须带规范分隔符" },
    { "outcome": { "interrupted": { "reason": { "invocation_may_have_occurred": { "invocation": "3f8b2c1a-7d4e-5f5a-8b9c-0d1e2f3a4b5c" } } } }, "why": "invocation 必须为 UUID v4" },
    { "outcome": { "interrupted": { "reason": { "invocation_may_have_occurred": { "invocation": "3f8b2c1a-7d4e-4f5a-7b9c-0d1e2f3a4b5c" } } } }, "why": "invocation 的 UUID variant 无效" },
    { "outcome": { "completed": { "finish_reason": "bogus" } }, "why": "completed 的 finish_reason 不在公开值域" },
    { "outcome": { "cancelled": { "reason": {} } }, "why": "cancelled 不接受空对象原因" },
    { "outcome": { "cancelled": { "reason": "timeout" } }, "why": "cancelled 不接受其他枚举的值" },
    { "outcome": { "failed": { "reason": "bogus" } }, "why": "failed 的 reason 不在公开值域" },
    { "outcome": { "interrupted": { "reason": "bogus" } }, "why": "interrupted 的 reason 不在公开值域" },
