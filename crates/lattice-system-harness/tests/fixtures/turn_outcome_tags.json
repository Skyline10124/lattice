    { "outcome": { "cancelled": { "reason": { "user_cancelled": null } } }, "why": "取消原因不是公开字符串形式" },
    { "outcome": { "interrupted": { "reason": { "model_attempt": "bogus" } } }, "why": "未知模型尝试中断原因" },
    { "outcome": { "interrupted": { "reason": { "model_attempt": {} } } }, "why": "模型尝试中断原因空对象" },
    { "outcome": { "interrupted": { "reason": { "model_attempt": { "timeout": null } } } }, "why": "模型尝试无负载原因不是公开字符串形式" },
