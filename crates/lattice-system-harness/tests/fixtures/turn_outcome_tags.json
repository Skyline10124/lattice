    { "outcome": { "completed": null }, "why": "负载为 null" },
    { "outcome": { "completed": {} }, "why": "completed 缺少 finish_reason" },
    { "outcome": { "completed": { "finish_reason": 1 } }, "why": "finish_reason 不是字符串" },
    { "outcome": { "failed": {} }, "why": "failed 缺少 reason" },
    { "outcome": { "failed": { "reason": null } }, "why": "reason 为 null" },
    { "outcome": { "cancelled": { "reason": 7 } }, "why": "reason 不是字符串或对象" },
    { "outcome": { "interrupted": { "reason": ["timeout"] } }, "why": "reason 是数组" }
  ]
