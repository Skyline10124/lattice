    { "outcome": { "interrupted": { "reason": { "model_attempt": "stream_error" } } }, "tag": "interrupted" },
    { "outcome": { "interrupted": { "reason": { "model_attempt": "cancelled" } } }, "tag": "interrupted" },
    { "outcome": { "interrupted": { "reason": { "model_attempt": "process_interrupted" } } }, "tag": "interrupted" },
