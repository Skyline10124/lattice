    { "outcome": { "interrupted": { "reason": { "model_attempt": { "output_limit_exceeded": { "kind": "assistant_content", "limit": 2097152, "actual": 2097153 } } } } }, "tag": "interrupted" },
    { "outcome": { "interrupted": { "reason": { "model_attempt": { "output_limit_exceeded": { "kind": "reasoning_content", "limit": 2097152, "actual": 2097153 } } } } }, "tag": "interrupted" },
    { "outcome": { "interrupted": { "reason": { "model_attempt": { "output_limit_exceeded": { "kind": "model_attempt_total", "limit": 16777216, "actual": 16777217 } } } } }, "tag": "interrupted" },
