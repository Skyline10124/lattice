# Official LATTICE Upper rootfs. Build inputs are version-controlled; the base
# digest is pinned in base-reference.txt and must match DEBIAN_BASE below.
# Runtime identity is never this file's tags — only the published manifest
# digest recorded in lock.json after a maintainer checkpoint.

ARG DEBIAN_BASE=debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818
FROM ${DEBIAN_BASE}

ARG OCI_SOURCE=https://codeberg.org/AstRin/LATTICE
ARG OCI_REVISION=unknown
ARG OCI_VERSION=dev

LABEL org.opencontainers.image.source=$OCI_SOURCE \
      org.opencontainers.image.revision=$OCI_REVISION \
      org.opencontainers.image.version=$OCI_VERSION

# Minimal capability set for baseline delivery / candidate export:
# git, CA certs, POSIX shell (/bin/sh), and baseline transfer tools from coreutils.
# No project toolchains. apt lists removed in the same layer.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        coreutils \
        dash \
        git \
    && rm -rf /var/lib/apt/lists/*

# No ENTRYPOINT and no bootstrap install: capability must exist in the final rootfs.
CMD ["/bin/sh"]
