{
  "name": "fetch__web",
  "version": "0.1.0",
  "description": "Fetch a URL over HTTP(S) and return its text content. The URL host must be permitted by the profile network allowlist. A blocked host is a policy decision, not a transient error: do not retry the same host; use an allowed host or request the host be added to the profile network allowlist.",
  "params_schema": {
    "additionalProperties": false,
    "properties": {
      "headers": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "url": {
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "url"
    ],
    "type": "object"
  },
  "result_schema": {
    "additionalProperties": false,
    "properties": {
      "body": {
        "type": "string"
      },
      "content_type": {
        "type": "string"
      },
      "final_origin": {
        "type": "string"
      },
      "redirect_count": {
        "maximum": 5,
        "minimum": 0,
        "type": "integer"
      },
      "status": {
        "maximum": 599,
        "minimum": 100,
        "type": "integer"
      },
      "truncated": {
        "type": "boolean"
      }
    },
    "required": [
      "status",
      "body",
      "truncated"
    ],
    "type": "object"
  },
  "scopes": [
    {
      "name": "external-host",
      "trust": "ex",
      "channel": "network"
    }
  ],
  "capabilities": [
    {
      "name": "network.fetch",
      "cell": {
        "ctx_op": "alloc",
        "ext_impact": "read",
        "scope": "external-host"
      }
    }
  ],
  "artifact": {
    "sha256": "0aa8bc2c753572ad82fe5f34af76e57174536e64b5845acb92b7347d04780a03",
    "toolchain": "rustc-1.96.0+wit-bindgen-0.60+wasm-tools-1.254.0"
  },
  "abi_version": 1
}
