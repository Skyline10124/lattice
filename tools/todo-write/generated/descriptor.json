{
  "name": "session.todo_write",
  "version": "0.1.0",
  "description": "Record the current task plan as a concise todo list for multi-step work.",
  "params_schema": {
    "additionalProperties": false,
    "properties": {
      "todos": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "content": {
              "minLength": 1,
              "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]",
              "type": "string"
            },
            "status": {
              "enum": [
                "pending",
                "in_progress",
                "completed"
              ],
              "type": "string"
            }
          },
          "required": [
            "content",
            "status"
          ],
          "type": "object"
        },
        "maxItems": 100,
        "not": {
          "contains": {
            "properties": {
              "status": {
                "const": "in_progress"
              }
            },
            "required": [
              "status"
            ],
            "type": "object"
          },
          "minContains": 2,
          "type": "array"
        },
        "type": "array"
      }
    },
    "required": [
      "todos"
    ],
    "type": "object"
  },
  "result_schema": {
    "additionalProperties": false,
    "properties": {
      "todos": {
