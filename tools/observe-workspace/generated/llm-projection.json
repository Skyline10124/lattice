{
  "function": {
    "description": "Observe workspace content in one of four fixed modes: read_file for one path, grep for regex search under a root, list_directory for one directory, or find_files for glob-like path search under a root. read_file returns content_hash; copy that exact value into mutate__edit expected_hash when editing, and do not compute, transform, or narrate the hash.",
    "name": "observe__workspace",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "request": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "limit": {
                  "minimum": 1,
                  "type": "integer"
                },
                "line_numbers": {
                  "type": "boolean"
                },
                "mode": {
                  "const": "read_file"
                },
                "offset": {
                  "minimum": 1,
                  "type": "integer"
                },
                "path": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "mode",
                "path"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "max_results": {
                  "minimum": 1,
                  "type": "integer"
                },
                "mode": {
                  "const": "grep"
                },
                "path": {
                  "type": "string"
                },
                "pattern": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "mode",
                "pattern"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "limit": {
                  "minimum": 1,
                  "type": "integer"
                },
                "mode": {
                  "const": "list_directory"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "mode",
                "path"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "limit": {
                  "minimum": 1,
                  "type": "integer"
                },
                "mode": {
                  "const": "find_files"
                },
                "path": {
                  "type": "string"
                },
                "pattern": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "mode",
                "pattern"
              ],
              "type": "object"
            }
          ]
        }
      },
      "required": [
        "request"
      ],
      "type": "object"
    }
  },
  "type": "function"
}
