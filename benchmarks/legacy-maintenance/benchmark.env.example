# Copy to benchmark.env and fill with a frozen target.

# Required: pinned real upstream project.
BENCH_PROJECT_URL=https://github.com/OWNER/REPO.git
BENCH_PROJECT_REV=0000000000000000000000000000000000000000
BENCH_PROJECT_NAME=owner-repo

# Required: copied issue/task context. Prefer a local target record over a live
# URL; use BENCH_ISSUE_URL only as supporting provenance.
BENCH_ISSUE_TITLE="Short maintenance task title"
BENCH_ISSUE_URL=https://github.com/OWNER/REPO/issues/123
BENCH_ISSUE_TEXT="Paste the frozen issue body or maintenance request here."

# Optional: model/provider.
BENCH_MODEL=compat:deepseek-v4-pro
OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
OPENAI_COMPATIBLE_API_KEY=

# Optional: runner behavior.
BENCH_VERIFY_COMMAND="cargo test"
BENCH_KEEP=1
BENCH_STRICT_PHASES=0
