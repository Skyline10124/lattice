# Copy selected values into your shell before running this benchmark.
#
# The benchmark requires one provider path.

# Anthropic
# export ANTHROPIC_API_KEY=
# export LANCET_DOGFOOD_MODEL=sonnet

# OpenAI
# export OPENAI_API_KEY=
# export LANCET_DOGFOOD_MODEL=openai:gpt-4o

# OpenAI-compatible
# export OPENAI_COMPATIBLE_API_KEY=
# export OPENAI_COMPATIBLE_BASE_URL=
# export LANCET_DOGFOOD_MODEL=compat:deepseek-v4-pro

# Optional
# export LANCET_DOGFOOD_SCENARIOS=smoke,mutation,command
# export LANCET_DOGFOOD_KEEP=1
# export LANCET_DOGFOOD_REPORT=build/tmp/benchmarks/lancet-dogfood/report.md
# export LANCET_DOGFOOD_BIN=target/debug/lattice
